# ReelForge Studio reads this file from <REELFORGE_HOME>\.env.local.
# Keep each value on one line. Replace placeholders locally; never commit a live key.
# REELFORGE_HOME and REELFORGE_PORT are process environment variables, not keys read from this file.

GOOGLE_TTS_API_KEY=YOUR_GOOGLE_TTS_API_KEY_HERE
ELEVENLABS_API_KEY=YOUR_ELEVENLABS_API_KEY_HERE
